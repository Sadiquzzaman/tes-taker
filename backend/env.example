# Application
APP_PORT=3000
NODE_ENV=development

# When behind a reverse proxy (NGINX etc.), set to true so req.ip is correct.
TRUST_PROXY=false

# Database Configuration
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_DB=tasktaker
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres123
# Development default: true. Production MUST be false (use migrations).
DATABASE_SYNCRONIZE=false
DATABASE_LOGGING=false
# Optionally run pending migrations automatically on boot (prefer a deploy step).
DATABASE_MIGRATIONS_RUN=false

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT / Refresh token
JWT_SECRET=your-secret-key-change-in-production
# Optional — defaults to JWT_SECRET. Prefer a separate secret in production.
REFRESH_TOKEN_SECRET=
REFRESH_TOKEN_TTL_DAYS=30

# Default ADMIN seed (created on boot only when no ADMIN/SUPER_ADMIN exists)
# Development defaults if unset: Admin / admin@testtaker.local / Admin@12345 / ADMIN00000001
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@testtaker.local
ADMIN_PASSWORD=Admin@12345
ADMIN_PHONE=ADMIN00000001

# Rate limiting (application-wide default; auth/OTP/payment have stricter overrides)
THROTTLE_TTL=60000
THROTTLE_LIMIT=300

# CORS — comma-separated origins for the frontend
CLIENT_ORIGIN=http://localhost:3000

# SMS Configuration (BulkSMS BD)
BULKSMS_API_KEY=your-api-key-here
BULKSMS_SENDER_ID=your-sender-id-here

# Email Configuration (Brevo API - Recommended)
BREVO_API_KEY=
EMAIL_FROM=noreply@testtaker.com
EMAIL_FROM_NAME=TestTaker

# Email Configuration (SMTP - Fallback, optional)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password-here

# Frontend / Backend public URLs (invitation links, OAuth, payments)
FRONTEND_URL=http://localhost:3000
FRONTEND_BASE_URL=http://localhost:3000
BACKEND_BASE_URL=http://localhost:4000

# Google OAuth (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional override; defaults to BACKEND_BASE_URL/api/v1/auth/google/callback
GOOGLE_CALLBACK_URL=

# SSLCommerz (payments)
SSL_STORE_ID=
SSL_STORE_PASSWORD=
SSL_SESSION_API=
SSL_VALIDATION_API=

# Storage (S3-ready; currently local only)
# STORAGE_DRIVER: local | s3  (s3 driver is prepared but not yet implemented)
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./uploads
AWS_S3_BUCKET=
AWS_S3_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
