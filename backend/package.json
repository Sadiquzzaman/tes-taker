{
  "name": "tasktaker",
  "version": "1.0.0",
  "description": "",
  "main": "dist/src/main",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node .",
    "start:worker": "node dist/src/worker.js",
    "start:worker:dev": "NODE_PATH=. ts-node --transpile-only src/worker.ts",
    "files:migrate-legacy": "NODE_PATH=. ts-node --transpile-only src/files-migrate-legacy.ts",
    "lint": "eslint src test",
    "typeorm": "typeorm-ts-node-commonjs -d ./src/data-source.ts",
    "migration:create": "typeorm-ts-node-commonjs migration:create ./src/migrations/Migration",
    "migration:generate": "nest build && typeorm migration:generate -d dist/src/data-source.entities.js ./src/migrations/Migration",
    "migration:run": "typeorm-ts-node-commonjs migration:run -d ./src/data-source.ts",
    "migration:revert": "typeorm-ts-node-commonjs migration:revert -d ./src/data-source.ts",
    "migration:show": "typeorm-ts-node-commonjs migration:show -d ./src/data-source.ts",
    "typeorm:prod": "typeorm -d dist/src/data-source.js",
    "migration:run:prod": "typeorm migration:run -d dist/src/data-source.js",
    "migration:revert:prod": "typeorm migration:revert -d dist/src/data-source.js",
    "migration:show:prod": "typeorm migration:show -d dist/src/data-source.js",
    "migration:check": "nest build && typeorm migration:generate --check -d dist/src/data-source.entities.js ./src/migrations/Check",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:e2e": "jest --config test/jest-e2e.config.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1126.0",
    "@aws-sdk/s3-request-presigner": "3.1126.0",
    "@bull-board/api": "9.10.5",
    "@bull-board/express": "9.10.5",
    "@getbrevo/brevo": "^4.0.1",
    "@nestjs/bullmq": "11.0.5",
    "@nestjs/common": "^11.1.6",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.6",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/mongoose": "^11.0.4",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/platform-socket.io": "^11.1.27",
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/typeorm": "^11.0.0",
    "@nestjs/websockets": "^11.1.27",
    "axios": "^1.12.2",
    "bcrypt": "^6.0.0",
    "bullmq": "6.4.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "dotenv": "^17.4.2",
    "helmet": "^8.3.0",
    "ioredis": "^5.8.0",
    "mongoose": "^9.9.3",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pg": "^8.16.3",
    "reflect-metadata": "~0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.4",
    "socket.io": "^4.8.3",
    "swagger-ui-express": "^5.0.1",
    "typeorm": "^0.3.27",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@nestjs/cli": "^11.0.10",
    "@nestjs/schematics": "^11.0.7",
    "@nestjs/testing": "^11.2.1",
    "@types/axios": "^0.14.4",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.3",
    "@types/ioredis": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.5.2",
    "@types/passport": "^1.0.17",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@types/sharp": "^0.32.0",
    "@types/uuid": "^11.0.0",
    "eslint": "9.39.5",
    "globals": "16.5.0",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "^5",
    "typescript-eslint": "8.72.0"
  }
}
