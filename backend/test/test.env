# Settings for the backend API tests (pnpm test:e2e). Loaded before the app starts;
# the app ignores backend/.env when NODE_ENV=test, so real keys never reach a test.
# Every value here is a throwaway for the local test containers in docker-compose.test.yml.
NODE_ENV=test
APP_PORT=0

DATABASE_HOST=localhost
DATABASE_PORT=55432
DATABASE_DB=tasktaker_test
DATABASE_USER=test
DATABASE_PASSWORD=test
DATABASE_SYNCRONIZE=false
DATABASE_LOGGING=false
DATABASE_MIGRATIONS_RUN=false

REDIS_HOST=localhost
REDIS_PORT=56379
REDIS_DB=0

MONGODB_URI=mongodb://localhost:57017/tasktaker_test

JWT_SECRET=test-only-jwt-secret
REFRESH_TOKEN_SECRET=test-only-refresh-secret
REFRESH_TOKEN_TTL_DAYS=30

ADMIN_NAME=Test Admin
ADMIN_EMAIL=admin@test.local
ADMIN_PASSWORD=Test-Admin-Password-1
ADMIN_PHONE=ADMIN00000001
SEED_TEST_USERS=false

THROTTLE_TTL=60000
THROTTLE_LIMIT=100000

CLIENT_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000
FRONTEND_BASE_URL=http://localhost:3000
BACKEND_BASE_URL=http://localhost:4000

# Outside services: fake values; all outbound HTTP is blocked in tests (test/support/outbound.ts).
BULKSMS_API_KEY=test
BULKSMS_SENDER_ID=test
SSL_STORE_ID=test_store
SSL_STORE_PASSWORD=test_store_password
SSL_SESSION_API=https://sslcommerz.test/gwprocess/v4/api.php
SSL_VALIDATION_API=https://sslcommerz.test/validator/api/validationserverAPI.php

STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=/tmp/tasktaker-test-uploads
