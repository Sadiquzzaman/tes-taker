# =============================================================================
# TaskTaker – production environment template
# =============================================================================
# Copy this file to `.env.production` (NEVER commit that file) and fill in
# real values before deploying:
#
#   cp .env.production.example .env.production
#   docker compose -f docker-compose.prod.yml --env-file .env.production up -d --build
#
# Legend:
#   [REQUIRED]  – must be set for a working production deploy
#   [OPTIONAL]  – has a sensible default; override as needed
# =============================================================================

# -----------------------------------------------------------------------------
# Runtime
# -----------------------------------------------------------------------------
NODE_ENV=production

# [OPTIONAL] Bind ports on the host (loopback only). Put NGINX/Caddy in front.
FRONTEND_HOST_PORT=3000
BACKEND_HOST_PORT=4000

# [OPTIONAL] Trust X-Forwarded-* headers from the reverse proxy (default: true).
TRUST_PROXY=true

# -----------------------------------------------------------------------------
# Public URLs  (replace with your real domains)
# -----------------------------------------------------------------------------
# [REQUIRED] Frontend origin(s) allowed by CORS. Comma-separated for multiple.
CLIENT_ORIGIN=https://app.example.com

# [REQUIRED] Absolute frontend URL (invitation links, OAuth redirects, etc.).
FRONTEND_URL=https://app.example.com
FRONTEND_BASE_URL=https://app.example.com

# [REQUIRED] Absolute backend URL (OAuth callback, SSLCommerz callbacks/IPN).
BACKEND_BASE_URL=https://api.example.com

# [REQUIRED] Browser-facing API base URL baked into the Next.js client bundle.
NEXT_PUBLIC_BASE_URL=https://api.example.com/api/v1
NEXT_PUBLIC_APP_URL=https://app.example.com

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
# [REQUIRED]
DATABASE_USER=tasktaker
DATABASE_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
DATABASE_DB=tasktaker

# [OPTIONAL] Production defaults shown. Do NOT enable synchronize in production.
DATABASE_SYNCRONIZE=false
DATABASE_LOGGING=false
# Set to true only if you want the app to run pending migrations on boot.
# Prefer running `pnpm migration:run` as a separate deploy step.
DATABASE_MIGRATIONS_RUN=false

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
# [REQUIRED] Strong password; redis is configured with --requirepass.
REDIS_PASSWORD=CHANGE_ME_STRONG_REDIS_PASSWORD
# [OPTIONAL]
REDIS_DB=0

# -----------------------------------------------------------------------------
# pgAdmin 4 (database admin UI — bound to 127.0.0.1:5050 only, never public)
# -----------------------------------------------------------------------------
# [REQUIRED for pgAdmin] Login for the pgAdmin web UI.
PGADMIN_DEFAULT_EMAIL=
PGADMIN_DEFAULT_PASSWORD=

# -----------------------------------------------------------------------------
# Auth / JWT
# -----------------------------------------------------------------------------
# [REQUIRED] Long random string (e.g. `openssl rand -hex 48`).
JWT_SECRET=CHANGE_ME_LONG_RANDOM_JWT_SECRET

# [OPTIONAL] Defaults to JWT_SECRET. Prefer a separate secret in production.
REFRESH_TOKEN_SECRET=CHANGE_ME_LONG_RANDOM_REFRESH_SECRET
# [OPTIONAL] Refresh token lifetime in days (default: 30).
REFRESH_TOKEN_TTL_DAYS=30

# -----------------------------------------------------------------------------
# Rate limiting
# -----------------------------------------------------------------------------
# [OPTIONAL] Application-wide default. Auth/OTP/payment have stricter overrides.
THROTTLE_TTL=60000
THROTTLE_LIMIT=300

# -----------------------------------------------------------------------------
# SMS (BulkSMS BD)
# -----------------------------------------------------------------------------
# [REQUIRED] for OTP / invite SMS. Leave blank only if SMS is not used.
BULKSMS_API_KEY=
BULKSMS_SENDER_ID=

# -----------------------------------------------------------------------------
# Email (Brevo)
# -----------------------------------------------------------------------------
# [REQUIRED] for invitation / password-reset emails.
BREVO_API_KEY=
EMAIL_FROM=noreply@example.com
EMAIL_FROM_NAME=TestTaker

# -----------------------------------------------------------------------------
# Google OAuth
# -----------------------------------------------------------------------------
# [OPTIONAL] Leave blank to disable Google sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Defaults to ${BACKEND_BASE_URL}/api/v1/auth/google/callback when unset.
GOOGLE_CALLBACK_URL=

# -----------------------------------------------------------------------------
# Payments (SSLCommerz)
# -----------------------------------------------------------------------------
# [OPTIONAL] Leave blank to disable payments.
SSL_STORE_ID=
SSL_STORE_PASSWORD=
SSL_SESSION_API=https://securepay.sslcommerz.com/gwprocess/v4/api.php
SSL_VALIDATION_API=https://securepay.sslcommerz.com/validator/api/validationserverAPI.php

# -----------------------------------------------------------------------------
# Storage (S3-ready; currently local only)
# -----------------------------------------------------------------------------
# [OPTIONAL] local | s3  (s3 driver is prepared but not yet implemented)
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./uploads
AWS_S3_BUCKET=
AWS_S3_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
