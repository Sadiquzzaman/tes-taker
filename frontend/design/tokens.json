{
  "$description": "Design tokens (plan §3.2, docs/ui/design-system.md). The only place raw values live. Run `pnpm tokens` after editing; it regenerates app/tokens.css (Tailwind @theme). Named by role, not by colour, so dark mode can be added later.",
  "color": {
    "primary": { "value": "#49734F", "note": "brand green; buttons, links, selected state" },
    "primary-hover": { "value": "#3D6242" },
    "primary-soft": { "value": "#EAF2EB", "note": "tint for selected rows and badges" },
    "ink": { "value": "#232A25", "note": "main text" },
    "ink-muted": { "value": "#6B6E6C", "note": "secondary text; darker than the old #747775 so it passes WCAG AA on canvas and primary-soft too" },
    "ink-inverse": { "value": "#FFFFFF", "note": "text on primary or dark fills" },
    "canvas": { "value": "#F6F5F1", "note": "page background (warm off-white)" },
    "surface": { "value": "#FFFFFF", "note": "cards" },
    "surface-raised": { "value": "#FFFFFF", "note": "menus, popovers; use with shadow-overlay" },
    "border": { "value": "#E5E5E5" },
    "success": { "value": "#1E7B47" },
    "success-soft": { "value": "#E6F4EA" },
    "warning": { "value": "#B54708", "note": "amber: needs action today" },
    "warning-soft": { "value": "#FFF4E5" },
    "danger": { "value": "#B42318" },
    "danger-soft": { "value": "#FEE4E2" },
    "info": { "value": "#175CD3" },
    "info-soft": { "value": "#EAF2FF" }
  },
  "font": {
    "sans": { "value": ["Instrument Sans", "Hind Siliguri", "ui-sans-serif", "system-ui", "sans-serif"], "note": "UI text; Bangla glyphs fall through to Hind Siliguri" },
    "bangla": { "value": ["Hind Siliguri", "Instrument Sans", "ui-sans-serif", "system-ui", "sans-serif"] },
    "display": { "value": ["DM Serif Display", "Georgia", "serif"], "note": "marketing headings only" }
  },
  "text": {
    "caption": { "size": "12px", "lineHeight": "1.5" },
    "body-sm": { "size": "14px", "lineHeight": "1.5" },
    "body": { "size": "16px", "lineHeight": "1.5" },
    "title-sm": { "size": "20px", "lineHeight": "1.5" },
    "title": { "size": "24px", "lineHeight": "1.5" },
    "display": { "size": "32px", "lineHeight": "1.5" }
  },
  "lineHeight": {
    "latin": { "value": "1.5" },
    "bangla": { "value": "1.7", "note": "applied to Bangla text (lang=bn) in P1-04" }
  },
  "radius": {
    "input": { "value": "6px" },
    "card": { "value": "10px" },
    "sheet": { "value": "16px", "note": "sheets and modals" }
  },
  "shadow": {
    "card": { "value": "0 1px 2px rgba(16, 24, 40, 0.06), 0 1px 3px rgba(16, 24, 40, 0.08)" },
    "overlay": { "value": "0 12px 24px -4px rgba(16, 24, 40, 0.12), 0 4px 8px -2px rgba(16, 24, 40, 0.06)" }
  },
  "motion": {
    "fast": { "duration": "150ms", "easing": "cubic-bezier(0, 0, 0.2, 1)", "note": "hover and focus (ease-out)" },
    "sheet": { "duration": "250ms", "easing": "cubic-bezier(0, 0, 0.2, 1)", "note": "sheets and modals" }
  },
  "spacing": {
    "$note": "4-point scale 4/8/12/16/24/32/48 = Tailwind's default spacing 1/2/3/4/6/8/12 (base 4px); no override needed.",
    "base": { "value": "4px" }
  }
