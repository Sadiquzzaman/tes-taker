NEXT_PUBLIC_BASE_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-side API URL for Next.js SSR (join/class preview, etc.).
# Local dev: use localhost (same as NEXT_PUBLIC_BASE_URL).
# Docker: set SERVER_API_URL=http://app:3000/api/v1 in docker-compose.
SERVER_API_URL=http://localhost:4000/api/v1

# Legacy aliases — prefer SERVER_API_URL above.
# INTERNAL_API_URL=http://app:3000/api/v1
# NEXT_PUBLIC_URL=http://localhost:4000/api/v1

NEXT_PUBLIC_ENABLE_FLAGGING=true
NEXT_PUBLIC_GREEN_LIMIT=5
NEXT_PUBLIC_LIGHT_GREEN_LIMIT=10
NEXT_PUBLIC_ORANGE_LIMIT=14
NEXT_PUBLIC_RED_LIMIT=15
NEXT_PUBLIC_DISQUALIFY_AFTER=15
NEXT_PUBLIC_SCREEN_SHARE_TIMEOUT=15
NEXT_PUBLIC_DOUBLE_DISPLAY_TIMEOUT=15
