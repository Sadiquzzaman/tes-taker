# Root-level development defaults used by docker-compose.yml.
# For production, copy `.env.production.example` → `.env.production` instead.

# Application
APP_PORT=3000
NODE_ENV=development

# Database Configuration
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_DB=tasktaker
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres123
DATABASE_SYNCRONIZE=true
DATABASE_LOGGING=false
DATABASE_MIGRATIONS_RUN=false

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT / Refresh token
JWT_SECRET=your-secret-key-change-in-production
REFRESH_TOKEN_SECRET=
REFRESH_TOKEN_TTL_DAYS=30

# Default ADMIN seed (created on boot only when no ADMIN/SUPER_ADMIN exists)
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@testtaker.local
ADMIN_PASSWORD=Admin@12345
ADMIN_PHONE=ADMIN00000001

# Rate limiting
THROTTLE_TTL=60000
THROTTLE_LIMIT=300

# CORS
CLIENT_ORIGIN=http://localhost:3000

# SMS (BulkSMS BD)
BULKSMS_API_KEY=your-api-key-here
BULKSMS_SENDER_ID=your-sender-id-here

# Email (Brevo)
BREVO_API_KEY=
EMAIL_FROM=noreply@testtaker.com
EMAIL_FROM_NAME=TestTaker

# Public URLs
FRONTEND_URL=http://localhost:3000
FRONTEND_BASE_URL=http://localhost:3000
BACKEND_BASE_URL=http://localhost:4000

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=

# SSLCommerz
SSL_STORE_ID=
SSL_STORE_PASSWORD=
SSL_SESSION_API=
SSL_VALIDATION_API=

# Storage (S3-ready)
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./uploads
AWS_S3_BUCKET=
AWS_S3_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
